# File: .env.example

# Copy to .env, then run: python scripts/generate_auth_secrets.py

ENVIRONMENT=development
PROJECT_NAME=pharmacy_identity_service
API_V1_STR=/api/v1
APP_VERSION=1.0.0
DEBUG=false
TIMEZONE=Asia/Kolkata

HOST=0.0.0.0
PORT=5555
DOCS_ENABLED=true
HOST_VALIDATION_ENABLED=false
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=false
MAX_REQUEST_BODY_BYTES=2097152
SLOW_REQUEST_THRESHOLD_MS=1000
SECURE_HEADERS_ENABLED=true
HSTS_ENABLED=false
TRUSTED_PROXY_ENABLED=false
TRUSTED_PROXY_CIDRS=[]

LOG_LEVEL=INFO
LOG_JSON=false
LOG_TO_FILE=false
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
LOG_QUEUE_SIZE=10000

# Host-run URL. Docker Compose overrides this hostname with "postgres".
POSTGRES_URL=postgresql+asyncpg://identity_app:identity_dev_password@127.0.0.1:5432/pharmacy_platform
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_COMMAND_TIMEOUT_SECONDS=15
SQL_POOL_SIZE=10
SQL_MAX_OVERFLOW=10
SQL_POOL_TIMEOUT_SECONDS=10
SQL_POOL_RECYCLE_SECONDS=1800
SQL_POOL_PRE_PING=true
SQL_ECHO=false
DATABASE_STARTUP_CHECK=true
DATABASE_SCHEMA_CHECK=true
HEALTHCHECK_TIMEOUT_SECONDS=3.0
DEEP_HEALTH_ENABLED=true

# Replace these development placeholders before any shared deployment.
AUTH_PEPPER=replace-this-with-at-least-32-random-characters-0000000000000000
JWT_ALGORITHM=HS256
JWT_SECRET=replace-this-with-at-least-64-random-characters-00000000000000000000000000000000
JWT_KEY_ID=local-primary
JWT_ISSUER=pharmacy-platform-identity
JWT_AUDIENCE=pharmacy-platform
JWT_PREVIOUS_PUBLIC_KEYS_B64={}
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
ACCESS_TOKEN_TTL_MINUTES=15
ACCESS_TOKEN_VERSION=1
ACCESS_TOKEN_V2_INCLUDE_ROLES=false
AUTH_LOGIN_REFRESH_RESPONSE_VERSION=1
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=10

PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_RESEND_WINDOW_SECONDS=3600
OTP_DEV_EXPOSE_CODE=false

EMAIL_VERIFICATION_REQUIRED=true
PHONE_VERIFICATION_REQUIRED=true
DEFAULT_ROLE_CODE=customer
DEFAULT_ROLE_REQUIRED=true
SELF_REGISTRATION_ROLE_CODES=["customer"]
AUTH_CHECK_SESSION_ON_EACH_REQUEST=true
AUTH_REFRESH_AUTHZ_ON_EACH_REQUEST=true

# Use memory only for one-process development. Staging and production must use Redis.
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_KEY_PREFIX=identity:rate-limit
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
OTP_REQUEST_RATE_LIMIT=5
OTP_REQUEST_RATE_WINDOW_SECONDS=600
OTP_VERIFY_RATE_LIMIT=10
OTP_VERIFY_RATE_WINDOW_SECONDS=300
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_WINDOW_SECONDS=900
TOKEN_REFRESH_RATE_LIMIT=30
TOKEN_REFRESH_RATE_WINDOW_SECONDS=60
TOKEN_LOGOUT_RATE_LIMIT=30
TOKEN_LOGOUT_RATE_WINDOW_SECONDS=60
API_STANDARD_RATE_LIMIT=120
API_STANDARD_RATE_WINDOW_SECONDS=60
API_SENSITIVE_RATE_LIMIT=30
API_SENSITIVE_RATE_WINDOW_SECONDS=60
API_ADMIN_READ_RATE_LIMIT=120
API_ADMIN_READ_RATE_WINDOW_SECONDS=60
API_ADMIN_WRITE_RATE_LIMIT=20
API_ADMIN_WRITE_RATE_WINDOW_SECONDS=60

# Delivery call is intentionally not active yet.
NOTIFICATION_API_URL=
NOTIFICATION_API_KEY=
NOTIFICATION_TIMEOUT_SECONDS=5

# Docker PostgreSQL initialization values.
POSTGRES_DB=pharmacy_platform
POSTGRES_USER=identity_app
POSTGRES_PASSWORD=identity_dev_password
